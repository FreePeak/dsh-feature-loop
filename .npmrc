# The harness packages in peerDependencies are supplied by the deployment, not
# installed here: some of their transitive dependencies are harness-internal
# (`@deepseek-ai/dsh-type-meta`) and are not on npm, so peer auto-installation
# fails the whole install. Mirrors the setting DSH profiles themselves use.
auto-install-peers=false

# A REGISTRY MIRROR, opt-in, for the case where npmjs is unreachable.
#
# Measured 2026-10-03 on a machine where registry.npmjs.org was unreachable and
# every install in this repo hung or failed — the container build died at
# `ERR_PNPM_META_FETCH_FAIL … Socket timeout`, `make profile` sat for nine
# minutes, and a bare `npm install` timed out. Bisected with openssl: the TLS
# handshake to Cloudflare's edge SUCCEEDS for `example.com` and STALLS for
# `registry.npmjs.org` and `npmjs.com`, while `registry.yarnpkg.com` on the
# same edge is fine. So it is SNI filtering on the path, not a Cloudflare
# outage, not DNS, and not this machine — and `nc` to port 443 succeeding is
# exactly why it looks like a hang.
#
# registry.npmmirror.com answers the same API and was verified to carry the
# packages this repo needs (`yaml` latest, `@deepseek-ai/dsh` 29 versions
# including 0.2.0-rc.2). Uncomment to use it:
#
#   npm_config_registry=https://registry.npmmirror.com
#
# Left commented deliberately: a mirror in a checked-in .npmrc is a supply-chain
# decision nobody asked for, and it silently changes where every package on a
# developer's machine comes from. It belongs in the environment of whoever is
# behind a filtered network, or in a profile's own npmrc.
