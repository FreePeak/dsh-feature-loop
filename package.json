{
  "name": "@freepeak/dsh-feature-loop",
  "version": "0.1.0",
  "description": "A book-shaped loop for bug-fixing and small features: budget ceilings, cheap-first routing, step-level review gate, and the Laya local judge",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "assets/mark.svg",
    "assets/mark-light.svg",
    "assets/mark-mono.svg",
    "assets/logo.svg",
    "assets/favicon.svg"
  ],
  "license": "MIT",
  "author": "Linh Doan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FreePeak/dsh-feature-loop.git"
  },
  "bugs": {
    "url": "https://github.com/FreePeak/dsh-feature-loop/issues"
  },
  "homepage": "https://github.com/FreePeak/dsh-feature-loop#readme",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "agent",
    "agent-loop",
    "coding-agent",
    "autonomous",
    "budget",
    "cost-control",
    "human-in-the-loop",
    "review-gate",
    "cordis"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "sync": "bash scripts/sync-upstream.sh",
    "demo": "bash demo/run.sh",
    "demo:reset": "bash demo/reset.sh",
    "demo:steps": "bash demo/run.sh --max-steps 6",
    "demo:cost": "bash demo/run.sh --budget 0.000001",
    "demo:nojudge": "bash demo/run.sh --judge none",
    "lint:workflows": "actionlint .github/workflows/*.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "0.1.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.4.0",
    "@deepseek-ai/dsh-agent": ">=0.1.5",
    "@deepseek-ai/dsh-llm": ">=0.1.5",
    "@deepseek-ai/dsh-session": ">=0.1.5",
    "@deepseek-ai/dsh-session-persistence": ">=0.1.5",
    "@deepseek-ai/dsh-session-projection": ">=0.1.5",
    "@deepseek-ai/dsh-settings": ">=0.1.5",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.5",
    "@deepseek-ai/dsh-tools": ">=0.1.5",
    "@deepseek-ai/dsh-scope": ">=0.1.5",
    "@deepseek-ai/dsh-brand": ">=0.1.5",
    "@deepseek-ai/dsh-invariants": ">=0.1.5",
    "@deepseek-ai/dsh-util-values": ">=0.1.5",
    "@deepseek-ai/dsh-agent-loop": ">=0.1.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "0.4.0",
    "@deepseek-ai/dsh-agent": "0.1.5",
    "@deepseek-ai/dsh-agent-loop": "0.1.5",
    "@deepseek-ai/dsh-brand": "0.1.5",
    "@deepseek-ai/dsh-invariants": "0.1.5",
    "@deepseek-ai/dsh-llm": "0.1.5",
    "@deepseek-ai/dsh-scope": "0.1.5",
    "@deepseek-ai/dsh-session": "0.1.5",
    "@deepseek-ai/dsh-session-persistence": "0.1.5",
    "@deepseek-ai/dsh-session-projection": "0.1.5",
    "@deepseek-ai/dsh-settings": "0.1.5",
    "@deepseek-ai/dsh-system-prompt": "0.1.5",
    "@deepseek-ai/dsh-tools": "0.1.5",
    "@deepseek-ai/dsh-util-values": "0.1.5",
    "@deepseek-ai/schemastery": "0.1.5",
    "tsdown": "^0.5.0",
    "typescript": "^5.8.0",
    "zod": "^3.24.0"
  }
}
